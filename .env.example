# ====================
# 模型来源与缓存配置
# ====================
MINERU_MODEL_SOURCE=modelscope
# MODELSCOPE_OFFLINE=1
MODELSCOPE_CACHE=/path/to/modelscope_cache
HF_HOME=/path/to/huggingface_cache

# ====================
# MinerU API 配置（PDF解析服务）
# ====================
MINERU_API_TOKEN=your_mineru_api_token
MINERU_BASE_URL=https://mineru.net/api/v4

# 临时文件根目录
MD_ROOT_DIR=./temp-files/

# ====================
# LLM API 配置（兼容 OpenAI 格式）
# ====================
OPEN_API_KEY=your_api_key
OPEN_API_BASE=https://your-api-base/v1
LLM_DEFAULT_MODEL=qwen-flash
LLM_DEFAULT_TEMPERATURE=0.1

# 视觉语言模型（图片理解）
VL_MODEL=qwen-vl-max
# 商品名识别模型
ITEM_MODEL=qwen-flash

# ====================
# BGE 嵌入模型配置
# ====================
BGE_M3_PATH=/path/to/bge-m3
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cpu
BGE_FP16=False

# BGE 重排序模型
BGE_RERANKER_LARGE=/path/to/bge-reranker-large
BGE_RERANKER_DEVICE=cpu
BGE_RERANKER_FP16=0

# 商品名诊断标志
ITEM_NAME_DIAG=1

# ====================
# 嵌入向量通用配置
# ====================
EMBEDDING_DIM=1024
EMBEDDING_MODEL=bge-m3

# ====================
# Milvus 向量数据库配置
# ====================
MILVUS_URL=http://localhost:19530
CHUNKS_COLLECTION=kb_chunks_v1
ITEM_NAME_COLLECTION=kb_item_names_v1
MILVUS_METRIC_TYPE=COSINE
MILVUS_MIN_COSINE_SCORE=0.75

# ====================
# MongoDB 文档数据库配置
# ====================
MONGO_URL=mongodb://admin:password@localhost:27017
MONGO_DB_NAME=kb001

# ====================
# MinIO 对象存储配置
# ====================
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=knowledge-base-v1

# ====================
# MCP 服务配置
# ====================
MCP_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1/mcps/WebSearch/sse
